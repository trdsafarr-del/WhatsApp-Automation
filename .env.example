# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Shopify Admin API Credentials (set these in Vercel / Railway / Render so Shopify stays linked across redeploys)
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
SHOPIFY_WEBHOOK_SECRET=""

# Shared Cloud Persistence (Required on Vercel to keep orders, Shopify settings & WhatsApp session across deploys/devices)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

