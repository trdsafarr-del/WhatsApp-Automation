# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Shopify Admin API Credentials (set these in Vercel / Railway / Render so Shopify stays linked across redeploys)
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
SHOPIFY_WEBHOOK_SECRET=""

# Primary Cloud Sync: Firebase Realtime Database (Optional server-side 24/7 sync for Vercel & Railway)
FIREBASE_RTDB_URL="https://shopify-9351f-default-rtdb.asia-southeast1.firebasedatabase.app"
FIREBASE_RTDB_SECRET=""

# Fallback Cloud Persistence (Optional Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional Admin Dashboard Passcode Override
DASHBOARD_PASSCODE=""
