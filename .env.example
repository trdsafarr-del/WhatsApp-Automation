# APP_URL: The URL where this applet is hosted.
# Used for Shopify Webhook URL generation and self-referential callbacks.
APP_URL="http://localhost:3000"

# Shopify Store Configuration (can also be configured directly in the Dashboard UI)
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_ACCESS_TOKEN=""
SHOPIFY_WEBHOOK_SECRET=""

# Optional: External Persistent WhatsApp QR Worker URL (for Vercel + Render/Railway split architecture)
WHATSAPP_WORKER_URL=""
WHATSAPP_WORKER_SECRET=""

# Optional: Official Meta WhatsApp Cloud API (if using Cloud API instead of Baileys QR)
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
